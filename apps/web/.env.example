DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=<the Consumer Key you were given>
DARAJA_CONSUMER_SECRET=<the Consumer Secret you were given>
DARAJA_PASSKEY=<the Passkey you were given>
DARAJA_SHORTCODE=174379
DARAJA_TILL=174379        # in sandbox, PartyB is the same as the shortcode

PUBLIC_BASE_URL=<your tunnel URL, see below>
CALLBACK_SECRET=<generate>
CRON_SECRET=<generate>

SUPABASE_URL=<from Supabase → Project Settings → API>
SUPABASE_SERVICE_ROLE_KEY=<same page, "service_role" key, never the anon key>